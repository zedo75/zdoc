{
    // Visit https://aka.ms/tsconfig to read more about this file
    "include": ["./src/**/*", "./*.d.ts"],
    "exclude": ["node_modules", "dist"],
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"]
        },
        "module": "es2020", // 指定生成的模块代码标准（ES2020 支持动态 import、import.meta 等）
        "target": "es6", // 指定编译后的 JavaScript 目标版本（ES6/ES2015）
        "types": ["vite/client", "node", "vue-router/auto", "element-plus/global"], // 包含的类型声明文件
        "moduleResolution": "Bundler",

        "sourceMap": true, // 生成源映射文件（.map），便于调试

        "declaration": true, // 生成对应的 .d.ts 声明文件（供其他 TS 项目使用）
        "declarationMap": true, // 生成声明文件的源映射，便于跳转到原始实现

        "noUncheckedIndexedAccess": false, // 禁止对未定义索引的访问进行类型检查
        "exactOptionalPropertyTypes": false, // 可选属性必须严格匹配

        "noImplicitReturns": true, // 函数所有路径都必须有明确返回值
        "noImplicitOverride": true, // 必须显式使用 override 关键字覆盖基类方法
        "noUnusedLocals": true, // 报告未使用的局部变量
        "noUnusedParameters": true, // 报告未使用的函数参数（以下划线开头可忽略）
        "noFallthroughCasesInSwitch": true, // 禁止 switch 语句中的 fallthrough 行为（遗漏 break）
        "noPropertyAccessFromIndexSignature": false, // 禁止使用索引签名直接访问属性（如 obj['prop']，false 表示允许）

        "strict": true, // 启用所有严格类型检查选项
        "jsx": "react-jsx", // 指定 JSX 语法为 React 17+ 的自动运行时
        "verbatimModuleSyntax": true, // 强制使用 ES 模块的导入/导出语法，禁止使用 CommonJS（如 require）
        "isolatedModules": true, // 确保每个文件都可以被独立编译（适用于非 TS 转译器如 Babel、esbuild）
        "noUncheckedSideEffectImports": true, // 检查 import 语句是否引用了未导出的模块
        "moduleDetection": "force", // 强制将每个文件视为独立模块（避免全局作用域污染）
        "skipLibCheck": true // 跳过 node_modules 中的类型检查，加速编译
    }
}
