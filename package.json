{
    "name": "zdoc",
    "addonType": "wps",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "pnpm exec lefthook install",
        "predev": "node scripts/wps.js dev --port 3889",
        "dev": "vite --port 3889",
        "build": "vite build",
        "build:install": "node scripts/wps.js install",
        "build:zip": "wpsjs build",
        "build:exe": "wpsjs build --exe",
        "prepreview": "node scripts/wps.js dev --port 4173",
        "preview": "vite preview",
        "fmt": "prettier --write src/ && prettier --write plugins/*/src/**/*.{js,ts}",
        "clear": "rimraf node_modules",
        "typecheck": "pnpm exec tsc --noEmit",
        "test": "vitest"
    },
    "imports": {
        "#vite-plugin-wps-enhance": "./plugins/vite-plugin-wps-enhance/src/index.ts"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "core-js": "^3.50.0",
        "element-plus": "^2.14.7",
        "vue": "^3.5.43",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.9.9",
        "@vitejs/plugin-legacy": "^8.2.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vueuse/components": "^15.0.0",
        "@vueuse/core": "^14.4.0",
        "autoprefixer": "^10.6.1",
        "chinese-number-format": "^2.0.3",
        "diff-match-patch-es": "^2.0.1",
        "lefthook": "^2.1.17",
        "postcss": "^8.5.29",
        "prettier": "^3.9.9",
        "sass-embedded": "^1.105.1",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "catalog:",
        "vite-plugin-bundle-obfuscator": "^1.13.2",
        "vite-plugin-wps-enhance": "workspace:*",
        "vitest": "^5.0.4",
        "wps-jsapi-declare": "^2.2.0"
    },
    "engines": {
        "pnpm": ">=11.0.0"
    }
}
