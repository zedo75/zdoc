{
    "name": "zdoc",
    "addonType": "wps",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "pnpm exec lefthook install",
        "dev": "vite --port 3889",
        "build": "vite build",
        "build:zip": "wpsjs build",
        "build:exe": "wpsjs build --exe",
        "preview": "vite preview",
        "fmt": "prettier --write src/ && prettier --write plugins/*/src/**/*.{js,ts}",
        "clear": "rimraf node_modules",
        "typecheck": "pnpm exec tsc --noEmit",
        "test": "vitest"
    },
    "imports": {
        "#vite-plugin-wps-enhance": "./plugins/vite-plugin-wps-enhance/src/index.ts"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "core-js": "^3.50.0",
        "element-plus": "^2.14.6",
        "radash": "^12.1.1",
        "vue": "^3.5.41",
        "vue-router": "catalog:",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.9.5",
        "@vitejs/plugin-legacy": "^8.2.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.4.0",
        "autoprefixer": "^10.5.4",
        "chinese-number-format": "^2.0.3",
        "diff-match-patch-es": "^2.0.1",
        "lefthook": "^2.1.10",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "catalog:",
        "vite-plugin-bundle-obfuscator": "^1.13.0",
        "vite-plugin-wps-enhance": "workspace:*",
        "vitest": "^4.1.10",
        "wps-jsapi-declare": "^2.2.0"
    },
    "engines": {
        "pnpm": ">=11.0.0"
    }
}
